{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2023.Array", "ES2020", "DOM", "DOM.Iterable", "ES2021.String", "ES2022.Array"],
    "skipLibCheck": true,
    "incremental": true,
    "types": ["vitest/globals"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "preserveSymlinks": true,
    "baseUrl": "./",
    "paths": {
      "override/*": ["./src/override/*"],
      "kestra-api/*": ["./src/generated/kestra-api/*"],
      "vue": ["./node_modules/vue/dist/vue.d.ts"],
      "@vue/runtime-core": ["./node_modules/@vue/runtime-core/dist/runtime-core.d.ts"],
      "@vue/runtime-dom": ["./node_modules/@vue/runtime-dom/dist/runtime-dom.d.ts"],
      "@vue/reactivity": ["./node_modules/@vue/reactivity/dist/reactivity.d.ts"],
      "@vue/compiler-dom": ["./node_modules/@vue/compiler-dom/dist/compiler-dom.d.ts"],
      "@kestra-io/ui-design-system/*": ["./node_modules/@kestra-io/ui-design-system/*"],
      "element-plus": ["./node_modules/element-plus"],
      "element-plus/*": ["./node_modules/element-plus/*"],
      "moment": ["./node_modules/moment"],
      "moment/*": ["./node_modules/moment/*"],
      "moment-timezone": ["./node_modules/moment-timezone"],
      "moment-timezone/*": ["./node_modules/moment-timezone/*"],
      "vue-i18n": ["./node_modules/vue-i18n"],
      "vue-i18n/*": ["./node_modules/vue-i18n/*"],
      "vue-router": ["./node_modules/vue-router"],
      "vue-router/*": ["./node_modules/vue-router/*"],
      "@vueuse/core": ["./node_modules/@vueuse/core"],
      "@vueuse/core/*": ["./node_modules/@vueuse/core/*"],
      "echarts": ["./node_modules/echarts"],
      "echarts/*": ["./node_modules/echarts/*"],
      "vue-echarts": ["./node_modules/vue-echarts"],
      "vue-echarts/*": ["./node_modules/vue-echarts/*"],
      "yaml": ["./node_modules/yaml"],
      "yaml/*": ["./node_modules/yaml/*"],
      "remark-frontmatter": ["./node_modules/remark-frontmatter"],
      "remark-directive": ["./node_modules/remark-directive"]
    }
  },
  "include": [
    ".storybook/preview.*",
    "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue",
    "tests/**/*.ts", "tests/**/*.tsx"
  ]
}
