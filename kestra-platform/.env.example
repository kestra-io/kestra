# =============================================================================
# KESTRA PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================
#
# IMPORTANT: Copy this file to .env and fill in actual values
# NEVER commit .env file to version control
#
# cp .env.example .env
#
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kestra
POSTGRES_USER=kestra
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Connection pool settings
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_MIN_IDLE=10

# -----------------------------------------------------------------------------
# KAFKA CONFIGURATION
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_NUM_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# For production, add authentication:
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_REDIS_PASSWORD
REDIS_DB=0

# -----------------------------------------------------------------------------
# ZOOKEEPER CONFIGURATION
# -----------------------------------------------------------------------------
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# -----------------------------------------------------------------------------
# KESTRA CORE CONFIGURATION
# -----------------------------------------------------------------------------
KESTRA_URL=http://localhost:8080
KESTRA_STORAGE_TYPE=local
KESTRA_STORAGE_LOCAL_BASE_PATH=/app/storage

# Worker group routing
KESTRA_WORKER_GROUPS_ENABLED=true

# Server configuration
KESTRA_SERVER_PORT=8080

# -----------------------------------------------------------------------------
# WORKER GROUP: SHARED
# -----------------------------------------------------------------------------
# Default worker pool for general workloads
WORKER_SHARED_REPLICAS=2
WORKER_SHARED_CPU_LIMIT=2
WORKER_SHARED_MEMORY_LIMIT=4G
WORKER_SHARED_NAMESPACE_FILTER=^(shared|platform|demo)\..*

# -----------------------------------------------------------------------------
# WORKER GROUP: CLIENT1 (Dedicated CPU)
# -----------------------------------------------------------------------------
WORKER_CLIENT1_REPLICAS=2
WORKER_CLIENT1_CPU_LIMIT=2
WORKER_CLIENT1_MEMORY_LIMIT=4G
WORKER_CLIENT1_NAMESPACE_FILTER=^enterprise\.client1\..*

# Client 1 isolated secrets (only accessible to client1 workers)
CLIENT1_AWS_ACCESS_KEY_ID=
CLIENT1_AWS_SECRET_ACCESS_KEY=
CLIENT1_AWS_REGION=us-east-1
CLIENT1_OPENAI_API_KEY=
CLIENT1_S3_BUCKET=

# -----------------------------------------------------------------------------
# WORKER GROUP: CLIENT2 (GPU-Enabled)
# -----------------------------------------------------------------------------
WORKER_CLIENT2_REPLICAS=1
WORKER_CLIENT2_CPU_LIMIT=4
WORKER_CLIENT2_MEMORY_LIMIT=16G
WORKER_CLIENT2_GPU_ENABLED=true
WORKER_CLIENT2_NAMESPACE_FILTER=^enterprise\.client2\..*

# Client 2 isolated secrets (only accessible to client2 workers)
CLIENT2_ANTHROPIC_API_KEY=
CLIENT2_PINECONE_API_KEY=
CLIENT2_PINECONE_ENVIRONMENT=
CLIENT2_GCP_PROJECT_ID=
CLIENT2_GCS_BUCKET=

# -----------------------------------------------------------------------------
# PLATFORM API CONFIGURATION (Phase 4)
# -----------------------------------------------------------------------------
# These will be used in Phase 4 when we build the management API
# PLATFORM_API_PORT=8000
# PLATFORM_API_SECRET_KEY=
# PLATFORM_JWT_SECRET_KEY=
# PLATFORM_JWT_ALGORITHM=HS256
# PLATFORM_JWT_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# STRIPE CONFIGURATION (Phase 4 - Billing)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Phase 4)
# -----------------------------------------------------------------------------
# SENDGRID_API_KEY=
# FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# -----------------------------------------------------------------------------
# Logging
LOG_LEVEL=INFO
KESTRA_LOG_LEVEL=INFO

# Metrics (Prometheus)
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Tracing (Jaeger)
JAEGER_ENABLED=false
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# -----------------------------------------------------------------------------
# DEVELOPMENT / PRODUCTION FLAGS
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# Feature flags
FEATURE_WORKER_GROUP_ROUTING=true
FEATURE_QUOTA_ENFORCEMENT=false
FEATURE_BILLING=false

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# API Keys for platform access (Phase 4)
# PLATFORM_ADMIN_API_KEY=

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# BACKUP & DISASTER RECOVERY
# -----------------------------------------------------------------------------
# BACKUP_ENABLED=false
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=7
# BACKUP_S3_BUCKET=

# -----------------------------------------------------------------------------
# GOVERNANCE & OBSERVABILITY (LangFuse)
# -----------------------------------------------------------------------------
# LangFuse for LLM observability, tracing, cost tracking
# Option 1: Use cloud.langfuse.com (managed)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Option 2: Self-hosted LangFuse (requires docker-compose.governance.yml)
# LANGFUSE_HOST=http://langfuse:3000
# LANGFUSE_DB_NAME=langfuse
# LANGFUSE_DB_USER=langfuse
# LANGFUSE_DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
# LANGFUSE_DB_PORT=5433
# LANGFUSE_URL=http://localhost:3000
# LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_TO_RANDOM_32_CHAR_STRING
# LANGFUSE_SALT=CHANGE_ME_TO_RANDOM_32_CHAR_STRING
# LANGFUSE_PORT=3000
# LANGFUSE_TELEMETRY_ENABLED=true
# LANGFUSE_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# COMPLIANCE & CONTENT SAFETY
# -----------------------------------------------------------------------------
# Azure Content Safety (optional - for harmful content detection)
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=

# Microsoft Presidio (PII detection) - runs locally, no API key needed
PRESIDIO_ENABLED=true

# -----------------------------------------------------------------------------
# GRAFANA (Metrics Dashboards)
# -----------------------------------------------------------------------------
# Uncomment to enable Grafana with docker-compose.governance.yml
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
# GRAFANA_PORT=3001
# GRAFANA_ALLOW_ANONYMOUS=false
# GRAFANA_PLUGINS=

# -----------------------------------------------------------------------------
# PROMETHEUS (Metrics Collection)
# -----------------------------------------------------------------------------
# PROMETHEUS_PORT=9090

# -----------------------------------------------------------------------------
# PGADMIN (PostgreSQL Administration)
# -----------------------------------------------------------------------------
# PGADMIN_EMAIL=admin@example.com
# PGADMIN_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
# PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# SLACK NOTIFICATIONS (for alerts and feedback)
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# -----------------------------------------------------------------------------
# QUALITY & GOVERNANCE THRESHOLDS
# -----------------------------------------------------------------------------
# Minimum quality score for agent responses (1-10)
QUALITY_THRESHOLD=7.0

# Monthly budget limit per customer (USD)
DEFAULT_CUSTOMER_BUDGET=500.00

# Alert when customer reaches % of budget
BUDGET_ALERT_THRESHOLD=80

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
