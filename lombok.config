config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
lombok.anyConstructor.addConstructorProperties = true
lombok.equalsAndHashCode.callSuper = call
lombok.tostring.callsuper = call
# Both Jackson 2 (Micronaut HTTP/controller binding, kept on Jackson 2 until the Micronaut 5 bump)
# and Jackson 3 (Kestra's own serialization, e.g. JacksonMapper) are on the classpath, so @Jacksonized
# is ambiguous without this: Lombok would silently default to emitting only Jackson-2 builder
# annotations (@JsonDeserialize/@JsonPOJOBuilder from com.fasterxml.jackson.*), which the v3
# ObjectMapper does not recognize at all. That made Jackson 3 fall back to field-based
# deserialization for every @Jacksonized class, silently discarding all @Builder.Default values.
lombok.jacksonized.jacksonVersion += 2
lombok.jacksonized.jacksonVersion += 3
