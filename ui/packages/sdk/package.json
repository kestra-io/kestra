{
  "name": "@kestra-io/sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./ai": "./dist/ai.js",
    "./blueprint-tags": "./dist/blueprint-tags.js",
    "./blueprints": "./dist/blueprints.js",
    "./client": "./dist/client.js",
    "./dashboards": "./dist/dashboards.js",
    "./executions": "./dist/executions.js",
    "./files": "./dist/files.js",
    "./flows": "./dist/flows.js",
    "./kv": "./dist/kv.js",
    "./logs": "./dist/logs.js",
    "./metrics": "./dist/metrics.js",
    "./misc": "./dist/misc.js",
    "./namespaces": "./dist/namespaces.js",
    "./outputs": "./dist/outputs.js",
    "./plugins": "./dist/plugins.js",
    "./secrets": "./dist/secrets.js",
    "./services": "./dist/services.js",
    "./shared": "./dist/shared.js",
    "./tenants": "./dist/tenants.js",
    "./triggers": "./dist/triggers.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "openapi-ts --watch & tsdown --watch",
    "play": "vite",
    "typecheck": "vue-tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "npm run build",
    "generate:openapi": "openapi-ts",
    "postinstall": "openapi-ts",
    "prebuild": "openapi-ts"
  },
  "dependencies": {
    "nprogress": "0.2.0",
    "axios": "1.13.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.96.0",
    "@types/node": "^25.5.0",
    "bumpp": "^11.0.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {}
}