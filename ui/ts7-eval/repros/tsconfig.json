{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "*.vue",
    "*.ts"
  ],
  "contentMappers": [
    {
      "package": "@vue/content-mapper",
      "extensions": [
        ".vue"
      ],
      "options": {
        "dataAttributes": [
          "data-*"
        ]
      }
    }
  ]
}
