{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vitest"]
  },
  "rereferences": [
    {"path": "./tsconfig.app.json"}
  ],
  "include": [
    ".storybook/preview.*",
    "scripts/**/*.ts",
    "src/translations/check.ts",
    "src/translations/compareTranslations.ts",
    "tests/fixtures/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/unit/**/*.tsx",
    "tests/unit/**/*.jsx",
    "tests/unit/**/*.vue",
    "tests/storybook/**/*.ts",
    "tests/storybook/**/*.tsx",
    "tests/storybook/**/*.jsx",
    "tests/storybook/**/*.vue",
    "src/utils/global.ts",
    "src/*.d.ts",
    // vue-tsgo (TypeScript 7) checks every file reachable through imports as part
    // of this project, so the app and workspace package sources must be covered
    // here for their ambient declarations and paths to apply to them.
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.json",
    "packages/design-system/src/**/*.ts",
    "packages/design-system/src/**/*.vue",
    "packages/topology/src/**/*.ts",
    "packages/topology/src/**/*.vue",
    "packages/slot-contracts/src/**/*.ts"
  ]
}
