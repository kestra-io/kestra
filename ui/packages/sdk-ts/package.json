{
  "name": "@kestra-io/sdk-ts",
  "type": "module",
  "version": "0.0.0",
  "description": "SDK for Kestra API in TypeScript",
  "author": "Kestra Team <team@kestra.io>",
  "license": "MIT",
  "homepage": "https://kestra.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kestra-io/kestra"
  },
  "bugs": {
    "url": "https://github.com/kestra-io/kestra/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./AI": "./dist/AI.js",
    "./Blueprint Tags": "./dist/Blueprint Tags.js",
    "./Blueprints": "./dist/Blueprints.js",
    "./client": "./dist/client.js",
    "./Dashboards": "./dist/Dashboards.js",
    "./Executions": "./dist/Executions.js",
    "./Files": "./dist/Files.js",
    "./Flows": "./dist/Flows.js",
    "./KV": "./dist/KV.js",
    "./Logs": "./dist/Logs.js",
    "./Metrics": "./dist/Metrics.js",
    "./Misc": "./dist/Misc.js",
    "./Namespaces": "./dist/Namespaces.js",
    "./Outputs": "./dist/Outputs.js",
    "./Plugins": "./dist/Plugins.js",
    "./Secrets": "./dist/Secrets.js",
    "./Services": "./dist/Services.js",
    "./shared": "./dist/shared.js",
    "./Tenants": "./dist/Tenants.js",
    "./Triggers": "./dist/Triggers.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite",
    "typecheck": "vue-tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "npm run build",
    "generate:openapi": "openapi-ts",
    "postinstall": "openapi-ts",
    "prebuild": "openapi-ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.96.0",
    "@types/node": "^25.5.0",
    "bumpp": "^11.0.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  },
  "inlinedDependencies": {
    "axios": "1.13.6"
  }
}