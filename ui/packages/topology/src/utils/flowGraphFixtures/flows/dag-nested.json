  "source" : "id: graph-dag-nested\nnamespace: io.kestra.tests\n\ntasks:\n  - id: dag\n    type: io.kestra.plugin.core.flow.Dag\n    tasks:\n      - task:\n          id: last\n          type: io.kestra.plugin.core.log.Log\n          message: last\n        dependsOn:\n          - group\n          - subflow\n          - inner-dag\n      - task:\n          id: first\n          type: io.kestra.plugin.core.log.Log\n          message: first\n      - task:\n          id: group\n          type: io.kestra.plugin.core.flow.Sequential\n          tasks:\n            - id: group-1\n              type: io.kestra.plugin.core.log.Log\n              message: group\n            - id: group-2\n              type: io.kestra.plugin.core.log.Log\n              message: group\n        dependsOn:\n          - first\n      - task:\n          id: subflow\n          type: io.kestra.plugin.core.flow.Subflow\n          namespace: io.kestra.tests\n          flowId: switch\n        dependsOn:\n          - first\n      - task:\n          id: inner-dag\n          type: io.kestra.plugin.core.flow.Dag\n          tasks:\n            - task:\n                id: inner-1\n                type: io.kestra.plugin.core.log.Log\n                message: inner\n            - task:\n                id: inner-2\n                type: io.kestra.plugin.core.log.Log\n                message: inner\n              dependsOn:\n                - inner-1\n        dependsOn:\n          - group\n      - task:\n          id: detached\n          type: io.kestra.plugin.core.log.Log\n          message: no dependency list at all\n        dependsOn: []\n      - task:\n          id: lone-group\n          type: io.kestra.plugin.core.flow.Parallel\n          tasks:\n            - id: lone-group-1\n              type: io.kestra.plugin.core.log.Log\n              message: lone\n    errors:\n      - id: dag-error\n        type: io.kestra.plugin.core.log.Log\n        message: error\n    finally:\n      - id: dag-finally\n        type: io.kestra.plugin.core.log.Log\n        message: finally\n",
