{
    "compilerOptions": {
        "target": "esnext",
        "lib": ["es2023", "DOM", "DOM.Iterable"],
        "moduleDetection": "force",
        "module": "preserve",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "strict": true,
        "noUnusedLocals": true,
        "composite": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "./node_modules/.tmp/types",
        "tsBuildInfoFile": "./node_modules/.tmp/types/tsconfig.app.tsbuildinfo",
        "esModuleInterop": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "rootDir": "./src"
    },
    // `src` alone does not pick up JSON: a bare directory expands to TypeScript's own extensions,
    // so the translation files an import reaches have to be matched explicitly. Same list as the
    // app's tsconfig.app.json.
    "include": ["src", "src/**/*.json"]
}
