  "source" : "id: graph-flow-sections\nnamespace: io.kestra.tests\n\ntasks:\n  - id: 100\n    type: io.kestra.plugin.core.log.Log\n    message: a numeric id is read as a string\n  - id: subflow\n    type: io.kestra.plugin.core.flow.Subflow\n    namespace: io.kestra.tests\n    flowId: switch\n  - id: cluster_group\n    type: io.kestra.plugin.core.flow.Sequential\n    tasks:\n      - id: cluster_group-1\n        type: io.kestra.plugin.core.log.Log\n        message: the cluster prefix is stripped from a cluster uid\n\nerrors:\n  - id: error-1\n    type: io.kestra.plugin.core.log.Log\n    message: error\n  - id: error-subflow\n    type: io.kestra.plugin.core.flow.Subflow\n    namespace: io.kestra.tests\n    flowId: switch\n  - id: error-group\n    type: io.kestra.plugin.core.flow.Sequential\n    tasks:\n      - id: error-group-1\n        type: io.kestra.plugin.core.log.Log\n        message: error\n\nfinally:\n  - id: finally-1\n    type: io.kestra.plugin.core.log.Log\n    message: finally\n  - id: finally-group\n    type: io.kestra.plugin.core.flow.Parallel\n    tasks:\n      - id: finally-group-1\n        type: io.kestra.plugin.core.log.Log\n        message: finally\n      - id: finally-group-2\n        type: io.kestra.plugin.core.log.Log\n        message: finally\n\nafterExecution:\n  - id: after-1\n    type: io.kestra.plugin.core.log.Log\n    message: after\n  - id: after-group\n    type: io.kestra.plugin.core.flow.Sequential\n    tasks:\n      - id: after-group-1\n        type: io.kestra.plugin.core.log.Log\n        message: after\n\ntriggers:\n  - id: schedule\n    type: io.kestra.plugin.core.trigger.Schedule\n    cron: \"0 * * * *\"\n  - id: webhook\n    type: io.kestra.plugin.core.trigger.Webhook\n    key: contract\n",
