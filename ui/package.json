{
    "name": "kestra",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "npm@11.16.0",
    "engines": {
        "node": ">=24",
        "npm": ">=11.7.0"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "predev": "node scripts/ensure-sdk.mjs",
        "dev": "vite --host",
        "prebuild": "node scripts/ensure-sdk.mjs",
        "plugin-count:update": "node --experimental-strip-types ./scripts/update_plugin_catalog_count.ts",
        "build": "vite build --emptyOutDir",
        "build:design": "npm run build --workspace=@kestra-io/design-system",
        "build:topology": "npm run build --workspace=@kestra-io/topology",
        "build:sdk": "node scripts/ensure-sdk.mjs",
        "generate:sbom": "cyclonedx-npm --spec-version 1.6 --omit dev --output-reproducible --output-format JSON --output-file build/sbom/bom.json",
        "generate:openapi-spec": "cd .. && ./gradlew :webserver:generateOpenapiSpec",
        "generate:sdk": "node scripts/ensure-sdk.mjs --check-spec",
        "preview": "vite preview",
        "precheck:types": "node scripts/ensure-sdk.mjs",
        "check:types": "vue-tsc --build packages/design-system/tsconfig.app.json && echo \"design-system compiled\" \\\n && vue-tsc --build tsconfig.app.json && echo \"app checked\" \\\n && vue-tsc --project tsconfig.test.json && echo \"test checked\"",
        "test:lint": "oxlint src packages tests && eslint && stylelint \"{src,packages,tests}/**/*.{vue,scss}\"",
        "check:ts-any": "node scripts/explicit-any/baseline.mjs src packages tests",
        "test:all": "vitest run --coverage",
        "test:unit": "vitest run --project=unit",
        "test:unit:shuffle": "vitest run --project=unit --sequence.shuffle.files",
        "test:storybook": "vitest run --project=storybook",
        "translations:check": "node ./scripts/translations/check-translations.mjs --scope oss && node --experimental-strip-types ./scripts/translations/check.ts",
        "translations:generate": "node --experimental-strip-types ./scripts/translations/generate.ts",
        "lint": "oxlint --fix src packages tests && eslint --fix && stylelint \"{src,packages,tests}/**/*.{vue,scss}\"",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "postinstall": "npx patch-package"
    },
    "dependencies": {
        "@kestra-io/design-system": "*",
        "@kestra-io/kestra-sdk": "*",
        "@kestra-io/slot-contracts": "*",
        "@kestra-io/topology": "*",
        "@module-federation/enhanced": "^2.9.2",
        "@vue-flow/background": "^1.3.2",
        "@vue-flow/controls": "^1.1.3",
        "@vue-flow/core": "^1.48.2",
        "@vueuse/core": "^15.0.0",
        "ansi-to-html": "^0.7.2",
        "change-case": "5.4.4",
        "cronstrue": "^3.32.0",
        "dagre": "^0.8.5",
        "echarts": "^6.1.0",
        "js-yaml": "^5.5.0",
        "mailchecker": "^6.0.21",
        "material-file-icons": "^2.4.0",
        "monaco-editor": "^0.57.0",
        "monaco-yaml": "5.5.1",
        "motion-v": "^2.8.0",
        "nprogress": "^0.2.0",
        "patch-package": "^8.0.1",
        "path-browserify": "^1.0.1",
        "pdfjs-dist": "^6.4.299",
        "pinia": "^4.1.0",
        "posthog-js": "^1.438.12",
        "rapidoc": "^11.0.1",
        "remark-directive": "^4.0.0",
        "remark-frontmatter": "^5.0.0",
        "semver": "^7.8.5",
        "uuid": "^14.0.3",
        "vue": "^3.5.44",
        "vue-echarts": "^8.3.2",
        "vue-gtag": "^3.7.1",
        "vue-i18n": "^11.4.14",
        "vue-material-design-icons": "^5.4.0",
        "vue-router": "^5.4.0",
        "vue-virtual-scroller": "^3.0.5",
        "xss": "^1.0.15",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@cyclonedx/cyclonedx-npm": "^6.0.1",
        "@eslint/css": "^2.0.1",
        "@google/genai": "^2.30.0",
        "@hey-api/openapi-ts": "0.99.0",
        "@module-federation/vite": "^1.23.5",
        "@playwright/test": "^1.64.1",
        "@storybook/addon-themes": "^10.6.2",
        "@storybook/addon-vitest": "^10.6.2",
        "@storybook/vue3-vite": "^10.6.2",
        "@types/node": "^26.6.5",
        "@types/nprogress": "^0.2.3",
        "@types/path-browserify": "^1.0.3",
        "@types/semver": "^7.8.0",
        "@typescript-eslint/parser": "^8.71.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitejs/plugin-vue-jsx": "^5.1.6",
        "@vitest/browser": "^5.0.5",
        "@vitest/browser-playwright": "^5.0.5",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/compiler-sfc": "^3.5.44",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^10.12.0",
        "eslint-plugin-storybook": "10.6.2",
        "eslint-plugin-vue": "^10.11.1",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "oxlint": "^1.88.0",
        "playwright": "^1.64.1",
        "postcss-html": "^2.0.0",
        "postcss-scss": "^4.0.9",
        "postcss-value-parser": "^4.2.0",
        "sass": "^1.105.2",
        "sass-embedded": "^1.105.2",
        "storybook": "^10.6.2",
        "storybook-vue3-router": "^7.0.0",
        "stylelint": "^17.16.0",
        "typescript": "^6",
        "vite": "^8.3.4",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "optionalDependencies": {
        "@esbuild/darwin-arm64": "^0.28.2",
        "@esbuild/darwin-x64": "^0.28.2",
        "@esbuild/linux-x64": "^0.28.2",
        "@rolldown/binding-darwin-arm64": "^1.2.14",
        "@rolldown/binding-darwin-x64": "^1.2.14",
        "@rolldown/binding-linux-x64-gnu": "^1.2.14",
        "@rollup/rollup-darwin-arm64": "^4.64.7",
        "@rollup/rollup-darwin-x64": "^4.64.7",
        "@rollup/rollup-linux-x64-gnu": "^4.64.7",
        "@swc/core-darwin-arm64": "^1.16.18",
        "@swc/core-darwin-x64": "^1.16.18",
        "@swc/core-linux-x64-gnu": "^1.16.18",
        "lightningcss-darwin-arm64": "^1.33.0",
        "lightningcss-darwin-x64": "^1.33.0",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    },
    "overrides": {
        "dompurify": "^3.4.13",
        "js-yaml@^4": "^4.3.2"
    },
    "lint-staged": {
        "**/*.scss": [
            "stylelint"
        ],
        "**/*.css": [
            "eslint --fix"
        ],
        "**/*.{js,mjs,cjs,ts}": [
            "oxlint --fix",
            "eslint --fix"
        ],
        "**/*.vue": [
            "oxlint --fix",
            "eslint --fix",
            "stylelint"
        ]
    },
    "allowScripts": {
        "@google/genai@2.30.0": true,
        "@parcel/watcher@2.6.0": true,
        "@scarf/scarf@1.4.0": true,
        "@tree-sitter-grammars/tree-sitter-yaml@0.7.1": true,
        "tree-sitter@0.22.4": true,
        "tree-sitter@0.21.1": true,
        "vue-demi@0.14.10": true,
        "core-js@3.50.0": true,
        "core-js-pure@3.49.0": true,
        "es5-ext@0.10.64": true,
        "esbuild@0.28.2": true,
        "fsevents@2.3.2": true,
        "fsevents@2.3.3": true,
        "protobufjs@7.6.6": true,
        "tree-sitter-json@0.24.8": true
    }
}
