{
  "name": "@kestra-io/sdk-ts",
  "type": "module",
  "version": "0.0.0",
  "description": "SDK for Kestra API in TypeScript",
  "author": "Kestra Team <team@kestra.io>",
  "license": "MIT",
  "homepage": "https://kestra.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kestra-io/kestra"
  },
  "bugs": {
    "url": "https://github.com/kestra-io/kestra/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client.gen": "./dist/client.gen.js",
    "./sdk/ks-AI.gen": "./dist/sdk/ks-AI.gen.js",
    "./sdk/ks-Blueprint Tags.gen": "./dist/sdk/ks-Blueprint Tags.gen.js",
    "./sdk/ks-Blueprints.gen": "./dist/sdk/ks-Blueprints.gen.js",
    "./sdk/ks-Dashboards.gen": "./dist/sdk/ks-Dashboards.gen.js",
    "./sdk/ks-Executions.gen": "./dist/sdk/ks-Executions.gen.js",
    "./sdk/ks-Files.gen": "./dist/sdk/ks-Files.gen.js",
    "./sdk/ks-Flows.gen": "./dist/sdk/ks-Flows.gen.js",
    "./sdk/ks-KV.gen": "./dist/sdk/ks-KV.gen.js",
    "./sdk/ks-Logs.gen": "./dist/sdk/ks-Logs.gen.js",
    "./sdk/ks-Metrics.gen": "./dist/sdk/ks-Metrics.gen.js",
    "./sdk/ks-Misc.gen": "./dist/sdk/ks-Misc.gen.js",
    "./sdk/ks-Namespaces.gen": "./dist/sdk/ks-Namespaces.gen.js",
    "./sdk/ks-Outputs.gen": "./dist/sdk/ks-Outputs.gen.js",
    "./sdk/ks-Plugins.gen": "./dist/sdk/ks-Plugins.gen.js",
    "./sdk/ks-Secrets.gen": "./dist/sdk/ks-Secrets.gen.js",
    "./sdk/ks-Services.gen": "./dist/sdk/ks-Services.gen.js",
    "./sdk/ks-shared.gen": "./dist/sdk/ks-shared.gen.js",
    "./sdk/ks-Tenants.gen": "./dist/sdk/ks-Tenants.gen.js",
    "./sdk/ks-Triggers.gen": "./dist/sdk/ks-Triggers.gen.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite",
    "typecheck": "vue-tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "npm run build",
    "generate:openapi": "openapi-ts",
    "postinstall": "openapi-ts",
    "prebuild": "openapi-ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.96.0",
    "@types/node": "^25.5.0",
    "bumpp": "^11.0.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  },
  "inlinedDependencies": {
    "axios": "1.13.6"
  }
}