config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
lombok.anyConstructor.addConstructorProperties = true
lombok.equalsAndHashCode.callSuper = call
lombok.tostring.callsuper = call
# Both majors: Kestra's JacksonMapper hub is Jackson 2, Micronaut's HTTP mapper is Jackson 3, and a
# @Jacksonized class can be read by either. Without the Jackson 3 annotations, deserialization on the HTTP
# side works only through Micronaut's @Experimental Jackson2AnnotationSupport compat layer.
lombok.jacksonized.jacksonVersion += 2
lombok.jacksonized.jacksonVersion += 3
