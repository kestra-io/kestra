{
  "name": "@kestra-io/design-system",
  "version": "0.0.0-dev",
  "description": "Kestra UI Design System – component abstractions over Element Plus",
  "type": "module",
  "homepage": "https://github.com/kestra-io/kestra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kestra-io/kestra.git"
  },
  "bugs": {
    "url": "https://github.com/kestra-io/kestra/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./shiki": "./src/components/Data/KsMarkdown/shikiHighlighter.ts",
    "./components/*": "./src/components/*",
    "./src/assets/styles/*": "./src/assets/styles/*",
    "./styles/color-palette": {
      "sass": "./src/assets/styles/_color-palette.scss"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6007 --no-open",
    "test": "npm run test:lint && npm run check:types && npm run test:unit && npm run test:storybook",
    "build:watch": "vite build --watch",
    "build-storybook": "storybook build",
    "check:types": "vue-tsc --noEmit",
    "lint": "oxlint --fix && eslint --fix",
    "test:lint": "oxlint && eslint",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest",
    "test:storybook": "vitest run --config vitest.config.ts --project 'storybook:*'",
    "generate:palette": "node scripts/generate-palette.mjs"
  },
  "peerDependencies": {
    "@vueuse/core": ">=11.0.0",
    "echarts": ">=6.0.0",
    "element-plus": ">=2.13.5",
    "monaco-editor": "*",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.4",
    "vue-material-design-icons": "^5.3.1",
    "vue-router": ">=5.0.0",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "echarts": ">=6.1.0",
    "element-plus": ">=2.14.7",
    "humanize-duration": "^3.35.0",
    "mermaid": "^12.2.0",
    "motion-v": "^2.8.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.5.0",
    "unified": ">=11.0.5",
    "vue": "^3.5.44",
    "vue-echarts": ">=8.3.2",
    "vue-i18n": "^11.4.16",
    "xss": "^1.0.16"
  },
  "devDependencies": {
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/vue3-vite": "^10.6.3",
    "@tsdown/css": "^0.23.1",
    "@types/humanize-duration": "^3.27.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "axe-core": "^4.14.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.105.2",
    "sass-embedded": "^1.105.2",
    "storybook": "^10.6.3",
    "tsdown": "^0.23.1",
    "typescript": "^6",
    "unrun": "^0.3.1",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vitest-browser-vue": "^3.1.0",
    "vue-component-type-helpers": "^3.3.13",
    "vue-material-design-icons": "^5.4.0",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.9.1"
  }
}
