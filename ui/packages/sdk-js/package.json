{
    "name": "@kestra-io/sdk-js",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "development": "./src/index.ts",
            "default": "./dist/index.js"
        },
        "./client.gen": {
            "types": "./src/client.gen.ts",
            "development": "./src/client.gen.ts",
            "default": "./dist/client.gen.js"
        },
        "./sdk/*": {
            "types": "./src/sdk/*.ts",
            "development": "./src/sdk/*.ts",
            "default": "./dist/sdk/*.js"
        }
    },
    "scripts": {
        "generate:openapi": "openapi-ts",
        "build": "tsdown"
    },
    "peerDependencies": {
        "axios": "*"
    }
}
