{
    "name": "@kestra-io/design-system",
    "version": "0.1.0",
    "description": "Kestra UI Design System – component abstractions over Element Plus",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./src/index.ts",
    "web-types": "./web-types.json",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./src/assets/styles/*": "./src/assets/styles/*"
    },
    "files": [
        "dist",
        "web-types.json"
    ],
    "scripts": {
        "dev": "storybook dev -p 6007 --no-open",
        "build": "./node_modules/.bin/vite build",
        "test": "npm run lint:test & npm run types:test & npm run unit:test & npm run storybook:test & wait",
        "build:watch": "vite build --watch",
        "unit:test": "vitest run --config vitest.unit.config.ts",
        "unit:watch": "vitest",
        "storybook:test": "vitest run --config vitest.config.ts --project 'storybook:*'",
        "storybook:build": "storybook build",
        "lint:fix": "eslint --fix",
        "lint:test": "eslint",
        "types:test": "vue-tsc --noEmit",
        "generate:palette": "node scripts/generate-palette.mjs"
    },
    "peerDependencies": {
        "@vueuse/core": ">=11.0.0",
        "bootstrap": "^5.3.8",
        "echarts": ">=5.4.0",
        "element-plus": ">=2.13.5",
        "moment": "^2.30.1",
        "moment-timezone": "^0.5.48",
        "vue": "^3.5.0",
        "vue-i18n": "^11.3.0",
        "vue-material-design-icons": "^5.3.1",
        "vue-router": ">=4.0.0",
        "yaml": "^2.8.2"
    },
    "dependencies": {
        "humanize-duration": "^3.33.2",
        "js-yaml": "^4.1.1",
        "shiki": "^4.0.2",
        "unified": ">=11.0.0",
        "remark-directive": "^4.0.0",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "vue-echarts": ">=7.0.0",
        "xss": "^1.0.15"
    },
    "devDependencies": {
        "element-plus": ">=2.13.5",
        "@eslint/js": "^9.39.4",
        "@storybook/addon-a11y": "^10.3.1",
        "@storybook/addon-docs": "^10.3.1",
        "@storybook/addon-themes": "^10.3.1",
        "@storybook/addon-vitest": "^10.3.1",
        "@storybook/vue3-vite": "^10.3.1",
        "@types/humanize-duration": "^3.27.4",
        "@types/js-yaml": "^4.0.9",
        "@types/mdast": "^4.0.4",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vitest/browser": "^4.1.0",
        "@vitest/browser-playwright": "^4.1.0",
        "@vitest/coverage-v8": "^4.1.0",
        "@vitest/runner": "^4.1.0",
        "@vue/test-utils": "^2.4.6",
        "@vueuse/core": "^11.0.0",
        "echarts": "^5.6.0",
        "happy-dom": "^20.8.4",
        "humanize-duration": "^3.33.2",
        "jsdom": "^29.0.0",
        "mermaid": "^11.14.0",
        "moment": "^2.30.1",
        "moment-timezone": "^0.5.48",
        "playwright": "^1.58.2",
        "sass-embedded": "^1.98.0",
        "storybook": "^10.3.1",
        "typescript": "^5.9.3",
        "vite": "^6.3.5",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^4.1.0",
        "vue": "^3.5.30",
        "vue-i18n": "^11.3.0",
        "vue-material-design-icons": "^5.3.1",
        "vue-router": "^4.0.0",
        "vue-tsc": "^3.2.6",
        "yaml": "^2.8.2",
        "eslint": "^9.39.4",
        "eslint-plugin-vue": "^9.33.0",
        "globals": "^16.0.0",
        "typescript-eslint": "^8.58.0"
    }
}
