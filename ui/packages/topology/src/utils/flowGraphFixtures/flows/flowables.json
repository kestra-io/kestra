{
  "source" : "id: graph-flowables\nnamespace: io.kestra.tests\n\ntasks:\n  - id: if-both\n    type: io.kestra.plugin.core.flow.If\n    condition: \"{{ true }}\"\n    then:\n      - id: if-both-then-1\n        type: io.kestra.plugin.core.log.Log\n        message: then\n      - id: if-both-then-2\n        type: io.kestra.plugin.core.log.Log\n        message: then\n    else:\n      - id: if-both-else\n        type: io.kestra.plugin.core.flow.Sequential\n        tasks:\n          - id: if-both-else-1\n            type: io.kestra.plugin.core.log.Log\n            message: else\n    errors:\n      - id: if-both-error\n        type: io.kestra.plugin.core.log.Log\n        message: error\n    finally:\n      - id: if-both-finally\n        type: io.kestra.plugin.core.log.Log\n        message: finally\n\n  - id: if-then-only\n    type: io.kestra.plugin.core.flow.If\n    condition: \"{{ true }}\"\n    then:\n      - id: if-then-only-1\n        type: io.kestra.plugin.core.log.Log\n        message: then\n\n  - id: pause-plain\n    type: io.kestra.plugin.core.flow.Pause\n\n  - id: pause-errors\n    type: io.kestra.plugin.core.flow.Pause\n    onPause:\n      id: pause-errors-on-pause\n      type: io.kestra.plugin.core.log.Log\n      message: paused\n    errors:\n      - id: pause-errors-error\n        type: io.kestra.plugin.core.log.Log\n        message: error\n\n  - id: pause-finally\n    type: io.kestra.plugin.core.flow.Pause\n    finally:\n      - id: pause-finally-1\n        type: io.kestra.plugin.core.log.Log\n        message: finally\n\n  - id: loop-until\n    type: io.kestra.plugin.core.flow.LoopUntil\n    condition: \"{{ true }}\"\n    tasks:\n      - id: loop-until-1\n        type: io.kestra.plugin.core.log.Log\n        message: loop\n      - id: loop-until-2\n        type: io.kestra.plugin.core.log.Log\n        message: loop\n\n  - id: wait-for\n    type: io.kestra.plugin.core.flow.WaitFor\n    condition: \"{{ true }}\"\n    tasks:\n      - id: wait-for-1\n        type: io.kestra.plugin.core.log.Log\n        message: loop\n\n  - id: working-directory\n    type: io.kestra.plugin.core.flow.WorkingDirectory\n    tasks:\n      - id: working-directory-1\n        type: io.kestra.plugin.core.log.Log\n        message: first\n      - id: working-directory-2\n        type: io.kestra.plugin.core.log.Log\n        message: second\n\n  - id: allow-failure\n    type: io.kestra.plugin.core.flow.AllowFailure\n    tasks:\n      - id: allow-failure-1\n        type: io.kestra.plugin.core.log.Log\n        message: first\n    errors:\n      - id: allow-failure-error\n        type: io.kestra.plugin.core.flow.Parallel\n        tasks:\n          - id: allow-failure-error-1\n            type: io.kestra.plugin.core.log.Log\n            message: error\n          - id: allow-failure-error-2\n            type: io.kestra.plugin.core.log.Log\n            message: error\n\n  - id: loop\n    type: io.kestra.plugin.core.flow.Loop\n    values: '[\"a\", \"b\"]'\n    tasks:\n      - id: loop-1\n        type: io.kestra.plugin.core.log.Log\n        message: first\n      - id: loop-2\n        type: io.kestra.plugin.core.flow.If\n        condition: \"{{ true }}\"\n        then:\n          - id: loop-2-then\n            type: io.kestra.plugin.core.log.Log\n            message: then\n      - id: loop-3\n        type: io.kestra.plugin.core.log.Log\n        message: third\n    errors:\n      - id: loop-error\n        type: io.kestra.plugin.core.log.Log\n        message: error\n    finally:\n      - id: loop-finally-1\n        type: io.kestra.plugin.core.log.Log\n        message: finally\n      - id: loop-finally-2\n        type: io.kestra.plugin.core.log.Log\n        message: finally\n\n  - id: parallel\n    type: io.kestra.plugin.core.flow.Parallel\n    tasks:\n      - id: parallel-1\n        type: io.kestra.plugin.core.log.Log\n        message: first\n      - id: parallel-2\n        type: io.kestra.plugin.core.flow.Switch\n        value: \"{{ 'a' }}\"\n        cases:\n          a:\n            - id: parallel-2-a\n              type: io.kestra.plugin.core.log.Log\n              message: a\n          b:\n            - id: parallel-2-b-1\n              type: io.kestra.plugin.core.log.Log\n              message: b\n            - id: parallel-2-b-2\n              type: io.kestra.plugin.core.log.Log\n              message: b\n        errors:\n          - id: parallel-2-error\n            type: io.kestra.plugin.core.log.Log\n            message: error\n        finally:\n          - id: parallel-2-finally\n            type: io.kestra.plugin.core.log.Log\n            message: finally\n    errors:\n      - id: parallel-error-1\n        type: io.kestra.plugin.core.log.Log\n        message: error\n      - id: parallel-error-2\n        type: io.kestra.plugin.core.log.Log\n        message: error\n    finally:\n      - id: parallel-finally\n        type: io.kestra.plugin.core.flow.Sequential\n        tasks:\n          - id: parallel-finally-1\n            type: io.kestra.plugin.core.log.Log\n            message: finally\n",
